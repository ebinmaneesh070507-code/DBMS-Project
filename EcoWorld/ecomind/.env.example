# Copy this file to .env and fill in your values.

# Points the frontend at your running backend.
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In (OAuth Client ID — NOT a Maps/Generative AI API key).
# Create one at https://console.cloud.google.com/apis/credentials
# (type: "OAuth client ID" -> "Web application"), then add this app's dev
# URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# This MUST be the exact same Client ID as GOOGLE_CLIENT_ID in the backend .env.
VITE_GOOGLE_CLIENT_ID=
