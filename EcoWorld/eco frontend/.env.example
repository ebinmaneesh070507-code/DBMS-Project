# Copy this file to .env and fill in your values.

# Your EcoMind backend (see ecomind-backend/.env for its own Gemini key —
# the frontend never calls Gemini directly, so no AI key belongs here).
VITE_API_BASE_URL=http://localhost:5000/api

# Optional. Get a free key at https://console.cloud.google.com/google/maps-apis
# (enable "Maps Embed API"). Used to show a small map preview of the
# location a citizen is reporting from. Without it, EcoMind falls back to
# a free OpenStreetMap embed that needs no key.
VITE_GOOGLE_MAPS_API_KEY=
