# ===================================
# EcoMind Backend - Environment Config
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file.
# ===================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/ecomind
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecomind
MONGO_URI=mongodb://127.0.0.1:27017/ecomind

# CORS - your frontend URL(s), comma separated
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# -----------------------------------
# AI Provider (Google Gemini - free tier)
# Get a key at: https://aistudio.google.com/app/apikey
# -----------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# If AI_PROVIDER=none or no key is set, the app falls back to mock AI responses
# so the frontend keeps working during development.

# Upload limits
MAX_UPLOAD_MB=5
